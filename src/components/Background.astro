<div class="bg" aria-hidden="true"></div>
<div class="card-glow" aria-hidden="true"></div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Own compositing layer, so the browser keeps it painted while the page scrolls */
    transform: translateZ(0);
    opacity: 0;
    animation: bg-in 1.6s var(--ease-out) 0.1s forwards;
  }
  .bg :global(canvas) { display: block; width: 100%; height: 100%; }
  .bg.off { display: none; }
  @keyframes bg-in { to { opacity: 1; } }

  .card-glow {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 0;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow, transparent), transparent);
    filter: blur(40px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s var(--ease-out);
  }
  .card-glow:global(.on) { opacity: 0.55; }
</style>

<script>
  import { startBackground } from '../scripts/bg/index';

  startBackground();
</script>
