---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  aspect?: string;
  eager?: boolean;
  parallax?: boolean;
  revealIndex?: number;
}
const { project, aspect = '4 / 5', eager = false, parallax = false, revealIndex = 0 } = Astro.props;
---

<a
  class:list={['card', { parallax }]}
  href={project.href}
  style={`aspect-ratio: ${aspect}; --reveal-i: ${revealIndex}`}
  data-reveal
>
  <span class="frame">
    <span class="media">
      <Image
        src={project.image}
        alt=""
        widths={[480, 720, 960]}
        sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 688px"
        loading={eager ? 'eager' : 'lazy'}
      />
    </span>
    <span class="glow" aria-hidden="true"></span>
    <span class="ring" aria-hidden="true"></span>
    <span class="label">
      <span class="title">{project.title}</span>
      <span class="category">{project.category}</span>
    </span>
    <span class="chip" aria-hidden="true">View case <span>→</span></span>
  </span>
</a>

<style>
  /*
    Hover effects are prototyped side by side; the active one is picked by
    data-card on <html>: zoom | tilt | chip | ring | unveil.
  */
  .card {
    display: block;
    position: relative;
    perspective: 900px;
  }
  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--card-c, var(--bw-15));
    isolation: isolate;
    /* Safari: keep rounded corners while children transform */
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform var(--dur) var(--ease-out);
  }

  .media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transition:
      transform var(--dur-slow) var(--ease-out),
      inset var(--dur-slow) var(--ease-out),
      border-radius var(--dur-slow) var(--ease-out),
      filter var(--dur) var(--ease-out);
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Parallax: the frame stays, the picture drifts slower than the page */
  @supports (animation-timeline: view()) {
    .parallax .media :global(img) {
      scale: 1.12;
      animation: drift linear both;
      animation-timeline: view();
    }
  }
  @keyframes drift {
    from { translate: 0 -5%; }
    to { translate: 0 5%; }
  }

  /* Soft light that follows the cursor */
  .glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, var(--glow-a, 0.1)),
      transparent 60%
    );
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  /* Border that lights up next to the cursor */
  .ring {
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.9),
      transparent 70%
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  .label {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(20, 20, 20, 0.45);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .title { font-weight: 500; font-size: 15px; line-height: 1.3; color: var(--bw-100); }
  .category { font-size: 13px; line-height: 1.3; color: var(--w-60); }

  /* Pill that follows the cursor */
  .chip {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 100px;
    background: var(--bw-100);
    color: #000;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    translate: calc(var(--mx, 50%) - 50%) calc(var(--my, 50%) - 50%);
    scale: 0.4;
    opacity: 0;
    transition:
      scale var(--dur) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .card:hover .label,
  .card:focus-visible .label {
    opacity: 1;
    transform: none;
  }
  /* Touch screens have no hover: keep the label visible */
  @media (hover: none) {
    .label { opacity: 1; transform: none; }
  }

  @media (hover: hover) {
    /* 1. Zoom: picture moves closer, soft light */
    :global(html:not([data-card])) .card:hover .media,
    :global(html[data-card='zoom']) .card:hover .media { transform: scale(1.04); }
    :global(html:not([data-card])) .card:hover .glow,
    :global(html[data-card='zoom']) .card:hover .glow { opacity: 1; }

    /* 2. Tilt: card leans towards the cursor, glare follows */
    :global(html[data-card='tilt']) .frame { transition: none; }
    :global(html[data-card='tilt']) .media {
      translate: calc(var(--px, 0) * -8px) calc(var(--py, 0) * -8px);
    }
    :global(html[data-card='tilt']) .card:hover .media { transform: scale(1.06); }
    :global(html[data-card='tilt']) .card:hover .glow { opacity: 1; --glow-a: 0.22; }

    /* 3. Chip: "View case" pill replaces the cursor */
    :global(html[data-card='chip']) .card { cursor: none; }
    :global(html[data-card='chip']) .chip { display: inline-flex; }
    :global(html[data-card='chip']) .card:hover .chip { scale: 1; opacity: 1; }
    :global(html[data-card='chip']) .card:hover .media { transform: scale(1.05); filter: brightness(0.85); }

    /* 4. Ring: lit border next to the cursor */
    :global(html[data-card='ring']) .card:hover .ring { opacity: 1; }
    :global(html[data-card='ring']) .card:hover .media { transform: scale(1.03); }
    :global(html[data-card='ring']) .card:hover .glow { opacity: 1; }

    /* 5. Unveil: picture steps back, the project's colour shows around it */
    :global(html[data-card='unveil']) .card:hover .media {
      inset: 6%;
      border-radius: 12px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
    }
    :global(html[data-card='unveil']) .card:hover .label { bottom: 1.5%; left: 6%; background: none; border-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; padding: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame, .media, .label, .glow, .ring, .chip { transition: none; }
    .card:hover .media { transform: none !important; }
    .parallax .media :global(img) { animation: none; scale: 1; }
  }
</style>

<script>
  // Tilt is driven by a small spring per card so entering and leaving ease
  // in and out instead of jumping when the cursor moves between cards.
  if (matchMedia('(hover: hover)').matches) {
    const tilt = () => document.documentElement.dataset.card === 'tilt';
    const MAX = 5; // degrees

    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const cur = { x: 0, y: 0 };
      const target = { x: 0, y: 0 };
      let raf = 0;

      const step = () => {
        cur.x += (target.x - cur.x) * 0.12;
        cur.y += (target.y - cur.y) * 0.12;
        card.style.setProperty('--px', cur.x.toFixed(4));
        card.style.setProperty('--py', cur.y.toFixed(4));
        card.style.setProperty('--rx', `${(-cur.y * MAX).toFixed(3)}deg`);
        card.style.setProperty('--ry', `${(cur.x * MAX).toFixed(3)}deg`);
        const settled = Math.abs(target.x - cur.x) < 0.001 && Math.abs(target.y - cur.y) < 0.001;
        raf = settled ? 0 : requestAnimationFrame(step);
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(step); };

      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        card.style.setProperty('--mx', `${x}px`);
        card.style.setProperty('--my', `${y}px`);
        if (!tilt()) return;
        target.x = (x / r.width) * 2 - 1;
        target.y = (y / r.height) * 2 - 1;
        kick();
      });
      card.addEventListener('pointerleave', () => {
        target.x = 0;
        target.y = 0;
        kick();
      });
    });
  }
</script>
