---
// Variant 1 — Showcase: one tool per row, big cover with a colour halo,
// rows alternate sides.
import { Image } from 'astro:assets';
import { tools } from '../../data/tools';
---

<section class="showcase">
  {tools.map((tool, i) => (
    <article class:list={['row', { flip: i % 2 }]} style={`--a: ${tool.accent}; --b: ${tool.accent2}`} data-reveal>
      <a class="cover" href={tool.href} target="_blank" rel="noopener" tabindex="-1" data-glow>
        <span class="halo" aria-hidden="true"></span>
        <Image src={tool.cover} alt="" widths={[400, 800]} sizes="(max-width: 800px) 100vw, 640px" />
      </a>
      <div class="text">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        {tool.icon && <Image class="icon" src={tool.icon} alt="" width={56} height={56} />}
        <span class="type"><i></i>{tool.type}</span>
        <h2>{tool.title}{tool.emoji && ` ${tool.emoji}`}</h2>
        <p>{tool.description}</p>
        <a class="cta" href={tool.href} target="_blank" rel="noopener">
          Open in Figma <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  ))}
</section>

<style>
  .showcase {
    display: grid;
    gap: clamp(64px, 9vw, 140px);
    max-width: 1200px;
    margin: clamp(64px, 8vw, 120px) auto 0;
    padding: 0 24px;
  }
  .row {
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .row.flip { grid-template-columns: 5fr 7fr; }
  .row.flip .cover { order: 2; }

  .cover {
    position: relative;
    display: block;
    border-radius: 20px;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .cover :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  /* Coloured light behind the cover */
  .halo {
    position: absolute;
    inset: 8% 6%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--a), transparent), radial-gradient(closest-side at 80% 70%, var(--b), transparent);
    filter: blur(60px);
    opacity: 0.45;
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }
  .row:hover .cover { transform: translateY(-6px) scale(1.015); }
  .row:hover .halo { opacity: 0.75; transform: scale(1.1); }

  .text { position: relative; }
  .num {
    position: absolute;
    top: -0.6em;
    right: 0;
    font-size: clamp(72px, 9vw, 140px);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }
  .text :global(.icon) {
    display: block;
    border-radius: 14px;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--a) 40%, transparent);
  }
  .type {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--a) 18%, transparent);
    color: color-mix(in srgb, var(--a) 60%, white);
    font-size: 13px;
    font-weight: 500;
  }
  .type i { width: 6px; height: 6px; border-radius: 50%; background: var(--a); box-shadow: 0 0 8px var(--a); }
  h2 {
    margin: 16px 0 12px;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  p { margin: 0; font-size: 18px; line-height: 1.5; color: var(--w-60); }

  .cta {
    position: relative;
    display: inline-flex;
    gap: 8px;
    margin-top: 28px;
    padding: 10px 20px;
    border-radius: 100px;
    font-weight: 500;
    font-size: 15px;
    background:
      linear-gradient(var(--bw-10), var(--bw-10)) padding-box,
      linear-gradient(120deg, var(--a), var(--b)) border-box;
    border: 1px solid transparent;
    transition: box-shadow var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }
  .cta span { transition: transform var(--dur) var(--ease-out); }
  .cta:hover {
    background:
      linear-gradient(120deg, var(--a), var(--b)) padding-box,
      linear-gradient(120deg, var(--a), var(--b)) border-box;
    box-shadow: 0 8px 30px color-mix(in srgb, var(--a) 45%, transparent);
  }
  .cta:hover span { transform: translate(2px, -2px); }

  @media (max-width: 800px) {
    .row, .row.flip { grid-template-columns: 1fr; }
    .row.flip .cover { order: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover, .halo, .cta, .cta span { transition: none; }
  }
</style>
