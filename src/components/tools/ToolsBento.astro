---
// Variant 2 — Bento: tiles of different sizes, each tinted with the colours
// of its cover, plus a tile for the Figma profile.
import { Image } from 'astro:assets';
import { tools, toolsIntro } from '../../data/tools';

// Grid area for each tool, in the same order as `tools`.
const areas = ['colo', 'tree', 'organic', 'kaizen', 'grid'];
const { profile } = toolsIntro;
---

<section class="bento">
  {tools.map((tool, i) => (
    <a
      class={`tile ${areas[i]}`}
      href={tool.href}
      target="_blank"
      rel="noopener"
      style={`--a: ${tool.accent}; --b: ${tool.accent2}; grid-area: ${areas[i]}; --reveal-i: ${i}`}
      data-reveal
      data-glow
    >
      <span class="wash" aria-hidden="true"></span>
      <span class="head">
        {tool.icon && <Image class="icon" src={tool.icon} alt="" width={40} height={40} />}
        <span class="txt">
          <span class="type">{tool.type}</span>
          <span class="title">{tool.title}{tool.emoji && ` ${tool.emoji}`}</span>
        </span>
        <span class="go" aria-hidden="true">↗</span>
      </span>
      <span class="desc">{tool.description}</span>
      <span class="shot">
        <Image src={tool.cover} alt="" widths={[400, 800]} sizes="(max-width: 800px) 100vw, 600px" />
      </span>
    </a>
  ))}
  <a class="tile profile" href={profile.href} target="_blank" rel="noopener" style="grid-area: profile; --a: #a259ff; --b: #1abcfe" data-reveal>
    <span class="wash" aria-hidden="true"></span>
    <Image class="avatar" src={profile.avatar} alt="" width={64} height={64} />
    <span class="title">All my resources</span>
    <span class="desc">{profile.label} ↗</span>
  </a>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-areas:
      'colo colo colo colo tree tree'
      'colo colo colo colo organic organic'
      'kaizen kaizen kaizen grid grid grid'
      'kaizen kaizen kaizen profile profile profile';
    gap: 16px;
    max-width: 1280px;
    margin: clamp(56px, 7vw, 100px) auto 0;
    padding: 0 24px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 280px;
    padding: 24px;
    border-radius: 24px;
    overflow: hidden;
    isolation: isolate;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color var(--dur) var(--ease-out), translate var(--dur-slow) var(--ease-out);
  }
  /* Colour wash in the cover's colours */
  .wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(80% 70% at 0% 0%, color-mix(in srgb, var(--a) 40%, transparent), transparent 70%),
      radial-gradient(70% 60% at 100% 100%, color-mix(in srgb, var(--b) 30%, transparent), transparent 70%);
    opacity: 0.55;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .tile:hover { border-color: color-mix(in srgb, var(--a) 50%, transparent); translate: 0 -4px; }
  .tile:hover .wash { opacity: 1; }

  .head { display: flex; align-items: center; gap: 12px; }
  .head :global(.icon) { border-radius: 10px; flex: none; }
  .txt { display: flex; flex-direction: column; }
  .type { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: color-mix(in srgb, var(--a) 55%, white); }
  .title { font-size: 20px; font-weight: 700; line-height: 1.2; }
  .go {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition: background var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .tile:hover .go { background: var(--bw-100); color: #000; transform: rotate(45deg); }
  .desc { color: var(--w-60); font-size: 15px; line-height: 1.4; }

  /* Cover peeks in from the bottom and rises on hover */
  .shot {
    margin-top: auto;
    margin-bottom: -48px;
    transform: translateY(12px) rotate(-1.5deg);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
  }
  .tile:hover .shot { transform: translateY(-8px) rotate(0deg); }

  .colo .shot, .kaizen .shot { width: 88%; align-self: center; }
  .kaizen .shot { margin-top: auto; margin-bottom: auto; transform: rotate(-1.5deg); }
  .tree .shot, .organic .shot { width: 92%; align-self: flex-end; margin-right: -32px; }

  .profile { align-items: flex-start; justify-content: flex-end; min-height: 200px; }
  .profile :global(.avatar) { border-radius: 50%; margin-bottom: auto; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08); }
  .profile .title { font-size: 28px; }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'colo colo' 'tree organic' 'kaizen kaizen' 'grid grid' 'profile profile';
    }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; grid-template-areas: 'colo' 'tree' 'organic' 'kaizen' 'grid' 'profile'; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile, .wash, .shot, .go { transition: none; }
  }
</style>
