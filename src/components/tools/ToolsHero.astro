---
import { Image } from 'astro:assets';
import { toolsIntro } from '../../data/tools';
const { title, subtitle, profile } = toolsIntro;
---

<section class="hero">
  <h1><span class="line"><span>{title}</span></span></h1>
  <p class="sub">{subtitle}</p>
  <a class="profile" href={profile.href} target="_blank" rel="noopener">
    <Image src={profile.avatar} alt="" width={24} height={24} />
    <span>{profile.label}</span>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
</section>

<style>
  .hero { text-align: center; padding: clamp(48px, 7vw, 90px) 24px 0; }
  h1 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .line > span {
    display: inline-block;
    background: linear-gradient(100deg, #fff 30%, #b9a6ff 50%, #ffd1a6 65%, #fff 80%);
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      rise var(--dur-slow) var(--ease-out) 150ms both,
      sheen 6s ease-in-out 1.2s infinite;
  }
  .sub {
    margin: clamp(16px, 2vw, 24px) 0 0;
    font-weight: 500;
    font-size: clamp(17px, 1.6vw, 22px);
    color: var(--w-50);
    animation: fade-up var(--dur-slow) var(--ease-out) 350ms both;
  }
  .profile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding: 6px 16px 6px 6px;
    border-radius: 100px;
    background: linear-gradient(180deg, var(--bw-15), var(--bw-10));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    color: var(--w-80);
    font-size: 14px;
    animation: fade-up var(--dur-slow) var(--ease-out) 500ms both;
    transition: box-shadow var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .profile :global(img) { border-radius: 50%; display: block; }
  .profile:hover { color: var(--bw-100); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); }
  .arrow { transition: transform var(--dur) var(--ease-out); }
  .profile:hover .arrow { transform: translate(2px, -2px); }

  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes sheen { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }
  @media (prefers-reduced-motion: reduce) {
    .line > span, .sub, .profile { animation: none; }
  }
</style>
