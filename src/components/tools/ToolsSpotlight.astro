---
// Variant 4 — List: big editorial rows. Hovering a row lights it in the tool's
// colours and the cover floats next to the cursor.
import { Image } from 'astro:assets';
import { tools } from '../../data/tools';
---

<section class="list">
  {tools.map((tool, i) => (
    <a class="item" href={tool.href} target="_blank" rel="noopener" style={`--a: ${tool.accent}; --b: ${tool.accent2}; --reveal-i: ${i}`} data-reveal data-glow>
      <span class="idx">{String(i + 1).padStart(2, '0')}</span>
      <span class="name">{tool.title}{tool.emoji && <span class="emoji"> {tool.emoji}</span>}</span>
      <span class="meta">
        <span class="type">{tool.type}</span>
        <span class="desc">{tool.description}</span>
      </span>
      <span class="arrow" aria-hidden="true">↗</span>
      <span class="float" aria-hidden="true">
        <Image src={tool.cover} alt="" widths={[400, 800]} sizes="360px" />
      </span>
    </a>
  ))}
</section>

<style>
  .list {
    max-width: 1200px;
    margin: clamp(56px, 7vw, 100px) auto 0;
    padding: 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 280px 40px;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px) 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: opacity var(--dur) var(--ease-out);
  }
  /* Dim the other rows while one is hovered */
  .list:has(.item:hover) .item:not(:hover) { opacity: 0.35; }

  .idx { font-size: 14px; color: var(--w-50); font-variant-numeric: tabular-nums; }
  .name {
    font-size: clamp(28px, 4.4vw, 60px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    background: linear-gradient(100deg, var(--a), var(--b)) 0 0 / 0% 100% no-repeat, linear-gradient(#fff, #fff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-size 0.8s var(--ease-out);
  }
  /* Gradient sweeps into the title on hover */
  .item:hover .name { background-size: 100% 100%, auto; }
  /* Emoji keeps its own colours inside the clipped gradient text */
  .emoji { color: initial; -webkit-text-fill-color: initial; }

  .meta { display: flex; flex-direction: column; gap: 4px; }
  .type { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: color-mix(in srgb, var(--a) 60%, white); }
  .desc { color: var(--w-60); font-size: 15px; line-height: 1.4; }
  .arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .item:hover .arrow { background: var(--bw-100); color: #000; transform: rotate(45deg); }

  /* Cover that follows the cursor */
  .float {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 340px;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    rotate: -4deg;
    translate: var(--fx, 50%) var(--fy, 0);
    transition:
      opacity var(--dur) var(--ease-out),
      scale var(--dur) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out);
  }
  .float :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 60px color-mix(in srgb, var(--a) 35%, transparent);
  }
  @media (hover: hover) {
    .item:hover .float { opacity: 1; scale: 1; rotate: 3deg; }
  }

  @media (max-width: 800px) {
    .item { grid-template-columns: 32px 1fr 40px; }
    .meta { grid-column: 2 / 3; }
    .arrow { grid-row: 1; grid-column: 3; }
    .float { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .item, .name, .arrow, .float { transition: none; }
  }
</style>

<script>
  // Float the cover a bit to the side of the cursor, smoothed.
  if (matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.list .item').forEach((item) => {
      let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
      const step = () => {
        x += (tx - x) * 0.15;
        y += (ty - y) * 0.15;
        item.style.setProperty('--fx', `${x}px`);
        item.style.setProperty('--fy', `${y}px`);
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
      };
      item.addEventListener('pointermove', (e) => {
        const r = item.getBoundingClientRect();
        tx = e.clientX - r.left + 32;
        ty = e.clientY - r.top - 120;
        if (!x && !y) { x = tx; y = ty; }
        if (!raf) raf = requestAnimationFrame(step);
      });
    });
  }
</script>
