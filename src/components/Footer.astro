---
import ContactButton from './ContactButton.astro';
const links = [
  { label: 'Instagram', href: 'https://www.instagram.com/valeo_mooha/' },
  { label: 'Telegram', href: 'https://t.me/ValeoMooha' },
  { label: 'WhatsApp', href: 'https://wa.me/380992637222' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/vmooha/' },
  { label: 'Dribbble', href: 'https://dribbble.com/Mooha' },
];
---

<footer class="footer">
  <nav class="links" aria-label="Social">
    {links.map((l) => <a href={l.href} rel="noopener" target="_blank">{l.label}</a>)}
  </nav>
  <ContactButton />
</footer>

<style>
  .footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 32px; padding: 96px 24px 48px; /* room for the constellation */
  }
  .links {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 6px 32px; max-width: 360px;
    font-weight: 500; font-size: 16px; line-height: 26px; color: var(--w-60);
  }
  .links a { transition: color 0.2s; }
  .links a:hover { color: var(--bw-100); }
</style>
