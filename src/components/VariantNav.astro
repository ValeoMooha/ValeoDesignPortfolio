---
// Prototype only: jump between design variants of a page.
interface Props {
  title: string;
  current: number;
  variants: { label: string; href: string }[];
}
const { title, current, variants } = Astro.props;
---

<nav class="variants" aria-label={`${title} variants`}>
  <span class="title">{title}</span>
  {variants.map((v, i) => (
    <a href={v.href} aria-current={i + 1 === current ? 'page' : undefined}>{i + 1} {v.label}</a>
  ))}
</nav>

<style>
  :global(body) { padding-bottom: 64px; }
  .variants {
    position: fixed;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    border-radius: 100px;
    background: rgba(20, 20, 20, 0.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
  }
  .title { padding: 0 8px 0 10px; color: var(--w-50); }
  a {
    padding: 6px 10px;
    border-radius: 100px;
    color: var(--w-60);
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s;
  }
  a:hover { color: var(--bw-100); }
  a[aria-current='page'] { background: rgba(255, 255, 255, 0.14); color: var(--bw-100); }
</style>
