---
// Variant 10 — Card: a holographic collector's card of the designer. It tilts
// and shimmers under the cursor and flips to show the philosophy. Below, the
// career reads like unlocked achievements and photos fan out like a hand of cards.
import { Image } from 'astro:assets';
import { bio, experience, intro, philosophy, photos, portraits, skills, stats } from '../../data/about';

const hand = photos.slice(0, 7);
---

<section class="hero">
  <div class="card-wrap">
    <button class="card" type="button" aria-label="Flip the card">
      <span class="face front">
        <span class="holo" aria-hidden="true"></span>
        <span class="top"><b>VALEO</b><span>{intro.role}</span></span>
        <Image class="art" src={portraits.main} alt="Valeo" widths={[480, 896]} sizes="340px" loading="eager" />
        <span class="stats">
          {stats.map((s) => <span><b>{s.value}</b><small>{s.label}</small></span>)}
        </span>
        <span class="foot">📍 Spain · #001</span>
      </span>
      <span class="face back">
        <span class="holo" aria-hidden="true"></span>
        <span class="back-in">
          <small>Philosophy</small>
          <b>{philosophy.replace('My philosophy: ', '')}</b>
        </span>
      </span>
    </button>
    <p class="tip">Move the cursor over the card · click to flip</p>
  </div>

  <div class="intro">
    <h1>{intro.greeting}</h1>
    <p>{bio}</p>
    <p class="status"><i></i>{intro.status}</p>
    <a class="resume" href={intro.resume.href}>{intro.resume.label} ↓</a>
  </div>
</section>

<section class="abilities">
  <h2>Abilities</h2>
  <div class="grid">
    {skills.map((s, i) => (
      <article data-reveal style={`--reveal-i: ${i % 3}`}>
        <span class="gem">{s.icon}</span>
        <h3>{s.title}</h3>
        <p>{s.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="quests">
  <h2>Achievements unlocked</h2>
  <ol>
    {experience.map((j, i) => (
      <li data-reveal>
        <span class="trophy" aria-hidden="true">{i === 0 ? '⭐' : '🏆'}</span>
        <span class="q-main"><b>{j.company}</b><small>{j.role}</small></span>
        <time>{j.period}</time>
      </li>
    ))}
  </ol>
</section>

<section class="hand-sec">
  <h2>{intro.photosCaption}</h2>
  <div class="hand" style={`--n: ${hand.length}`}>
    {hand.map((p, i) => (
      <Image src={p} alt="" width={320} style={`--i: ${i}`} />
    ))}
  </div>
</section>

<style>
  section { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  h2 { margin: 0 0 32px; font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.01em; }

  .hero { display: grid; grid-template-columns: auto 1fr; gap: 72px; align-items: center; min-height: calc(100vh - 64px); }

  /* Card: tilt follows the cursor, the holo layer shifts with it */
  .card-wrap { perspective: 1200px; text-align: center; }
  .card {
    position: relative; display: block; width: 340px; aspect-ratio: 63 / 88;
    padding: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(calc(var(--ry, 0deg) + var(--flip, 0deg)));
    transition: transform 0.15s linear;
    animation: deal 1.2s var(--ease-out) backwards;
  }
  .card.flipping { transition: transform 0.9s var(--ease-out); }
  .face {
    position: absolute; inset: 0; border-radius: 20px; overflow: hidden;
    backface-visibility: hidden;
    padding: 14px; display: flex; flex-direction: column; gap: 10px; text-align: left;
    background: linear-gradient(160deg, #2a2340, #121018 60%);
    border: 2px solid transparent;
    background-clip: padding-box;
    box-shadow: 0 0 0 2px rgba(255, 220, 160, 0.55), 0 40px 80px rgba(0, 0, 0, 0.6);
  }
  .back { transform: rotateY(180deg); justify-content: center; }
  .holo {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; mix-blend-mode: color-dodge; opacity: 0.55;
    background:
      linear-gradient(115deg, transparent 20%, rgba(255, 0, 170, 0.35) 36%, rgba(0, 220, 255, 0.35) 46%, rgba(255, 255, 0, 0.3) 56%, transparent 72%) var(--hx, 50%) var(--hy, 50%) / 250% 250%,
      radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, 0.35), transparent 45%);
  }
  .top { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; color: var(--w-60); }
  .top b { font-size: 22px; letter-spacing: 0.1em; color: #ffdca0; }
  .face :global(.art) { width: 100%; flex: 1; min-height: 0; object-fit: cover; border-radius: 10px; border: 1px solid rgba(255, 220, 160, 0.4); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .stats > span { padding: 6px 8px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); }
  .stats b { display: block; font-size: 18px; color: #ffdca0; }
  .stats small { font-size: 10px; line-height: 1.2; color: var(--w-60); }
  .foot { font-size: 11px; color: var(--w-50); text-align: right; }
  .back-in { position: relative; z-index: 2; padding: 16px; }
  .back-in small { display: block; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.2em; color: #ffdca0; font-size: 12px; }
  .back-in b { font-size: 24px; line-height: 1.25; }
  .tip { margin: 20px 0 0; font-size: 13px; color: var(--w-50); }

  .intro h1 { margin: 0 0 20px; font-size: clamp(44px, 5vw, 76px); letter-spacing: -0.02em; line-height: 1; }
  .intro p { margin: 0; font-size: 20px; line-height: 1.6; color: var(--w-80); }
  .status { display: flex; align-items: center; gap: 10px; margin-top: 28px !important; font-size: 17px !important; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: #3bd16f; box-shadow: 0 0 10px #3bd16f; }
  .resume { display: inline-block; margin-top: 20px; padding: 12px 22px; border-radius: 100px; background: linear-gradient(135deg, #ffdca0, #ff8fb1); color: #000; font-weight: 700; transition: scale var(--dur) var(--ease-out); }
  .resume:hover { scale: 1.05; }

  .abilities { margin-top: 120px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid article { padding: 24px; border-radius: 20px; background: linear-gradient(160deg, rgba(42, 35, 64, 0.8), rgba(18, 16, 24, 0.8)); border: 1px solid rgba(255, 220, 160, 0.15); transition: border-color var(--dur) var(--ease-out), translate var(--dur) var(--ease-out); }
  .grid article:hover { border-color: rgba(255, 220, 160, 0.5); translate: 0 -4px; }
  .gem { display: grid; place-items: center; width: 44px; height: 44px; rotate: 45deg; border-radius: 10px; background: linear-gradient(135deg, #ffdca0, #ff8fb1); color: #000; font-size: 18px; }
  .grid h3 { margin: 18px 0 8px; font-size: 19px; }
  .grid p { margin: 0; color: var(--w-60); line-height: 1.5; }

  .quests { margin-top: 120px; }
  .quests ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .quests li { display: grid; grid-template-columns: 48px 1fr auto; align-items: center; gap: 16px; padding: 14px 18px; border-radius: 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.07); }
  .trophy { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 220, 160, 0.1); font-size: 22px; }
  .q-main b { display: block; font-size: 18px; }
  .q-main small { color: var(--w-60); }
  .quests time { color: #ffdca0; font-size: 14px; font-variant-numeric: tabular-nums; }

  /* Photos held like a hand of cards; they spread out on hover */
  .hand-sec { margin-top: 120px; }
  .hand-sec h2 { font-size: 20px; color: var(--w-60); font-weight: 500; }
  .hand { position: relative; height: 420px; display: flex; justify-content: center; }
  .hand :global(img) {
    position: absolute; bottom: 0; width: 220px; aspect-ratio: 4 / 5; height: auto; object-fit: cover;
    border-radius: 14px; border: 3px solid #f4f1ea; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    transform-origin: 50% 160%;
    --off: calc(var(--i) - (var(--n) - 1) / 2);
    rotate: calc(var(--off) * 6deg);
    transition: rotate 0.6s var(--ease-out), translate 0.6s var(--ease-out), scale 0.3s var(--ease-out);
  }
  .hand:hover :global(img) { rotate: calc(var(--off) * 14deg); translate: calc(var(--off) * 40px) 0; }
  .hand :global(img:hover) { scale: 1.08; z-index: 2; }

  @keyframes deal { from { opacity: 0; transform: translateY(60px) rotateY(-30deg) rotateX(10deg); } }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 32px; }
    .card { width: min(320px, 80vw); margin: 0 auto; }
    .grid { grid-template-columns: 1fr; }
    .hand :global(img) { width: 150px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { animation: none; }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('.card')!;
  let flipped = false;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce && matchMedia('(hover: hover)').matches) {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      card.style.setProperty('--ry', `${(px - 0.5) * 24}deg`);
      card.style.setProperty('--rx', `${(0.5 - py) * 24}deg`);
      card.style.setProperty('--hx', `${px * 100}%`);
      card.style.setProperty('--hy', `${py * 100}%`);
      card.style.setProperty('--gx', `${px * 100}%`);
      card.style.setProperty('--gy', `${py * 100}%`);
    });
    card.addEventListener('pointerleave', () => {
      card.classList.add('flipping');
      card.style.setProperty('--rx', '0deg');
      card.style.setProperty('--ry', '0deg');
    });
  }
  card.addEventListener('click', () => {
    flipped = !flipped;
    card.classList.add('flipping');
    card.style.setProperty('--flip', flipped ? '180deg' : '0deg');
  });
  card.addEventListener('transitionend', () => card.classList.remove('flipping'));
</script>
