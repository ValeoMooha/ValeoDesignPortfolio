---
// About page in the live site's structure: hero, photo collage, philosophy,
// skills cards with illustrations, work experience and clients.
// `fx` picks how the skill illustrations move (five variants to compare).
import { Image } from 'astro:assets';
import { bio, clients, experience, intro, philosophy, photos, portraits, skills } from '../../data/about';
import { indexShapes } from '../../lib/svg';
import downloadIcon from '../../assets/about/download-icon.svg?raw';

export type SkillFx = 'assemble' | 'float' | 'cursor' | 'pop' | 'live';
interface Props { fx: SkillFx }
const { fx } = Astro.props;

// Six tiles that each cycle through their own photos; the main portrait leads the last tile.
const pool = photos.filter((p) => p !== portraits.main);
const tiles = Array.from({ length: 6 }, (_, k) => pool.filter((_, i) => i % 6 === k));
tiles[5] = [portraits.main, ...tiles[5]];

const skillKeys = ['ds', 'ui', 'ux', 'brand', 'video', 'marketing'];
---

<section class="hero">
  <h1>
    <span class="line"><span style="--d: 0">{intro.greeting}</span></span>
    <span class="line"><span style="--d: 1">{intro.role}</span></span>
    <span class="line"><span style="--d: 2">{intro.location}</span></span>
  </h1>
  <div class="cta">
    <p>Looking for full-time<br />remote position</p>
    <a class="resume" href={intro.resume.href}>
      {intro.resume.label}
      <span class="dl" set:html={downloadIcon} />
    </a>
  </div>
</section>

<section class="collage" aria-label="Photos">
  {tiles.map((set, t) => (
    <div class={`tile t${t}`} data-tile={t}>
      {set.map((p, i) => (
        <Image class:list={{ on: i === 0 }} src={p} alt="" widths={[420, 640]} sizes="(max-width: 800px) 50vw, 380px" loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>
  ))}
  <p class="caption">{intro.photosCaption}</p>
</section>

<section class="mission">
  <p class="philosophy" data-reveal>{philosophy}</p>
  <p class="bio" data-reveal style="--reveal-i: 1">{bio}</p>
</section>

<section class="skills" data-fx={fx}>
  <h2>Skills and expertise</h2>
  <div class="grid">
    {skills.map((s, i) => (
      <article class="skill" data-skill={skillKeys[i]} data-reveal style={`--reveal-i: ${i % 2}`}>
        <div class="art" set:html={indexShapes(s.art)} />
        <h3>{s.lines[0]}<br />{s.lines[1]}</h3>
        <p>{s.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="work">
  <h2>Work experience</h2>
  <ul>
    {experience.map((j) => (
      <li data-reveal>
        <span class="ico" set:html={j.icon} />
        <span class="co">{j.company}</span>
        <span class="role">{j.role}</span>
        <span class="yr">{j.period.replace('–', '-')}</span>
      </li>
    ))}
  </ul>
</section>

<section class="clients">
  <h2>Clients</h2>
  <ul>
    {clients.map((c, i) => (
      <li data-reveal style={`--reveal-i: ${i % 5}`} title={c.name} set:html={c.logo} />
    ))}
  </ul>
</section>

<style>
  section { max-width: 1152px; margin: 0 auto; padding: 0 24px; }
  h2 { margin: 0 0 32px; font-size: 24px; letter-spacing: -0.01em; }

  /* Hero */
  .hero { display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; padding-top: 48px; }
  h1 { margin: 0; font-size: clamp(36px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.01em; }
  .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .line > span { display: inline-block; animation: rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(150ms + var(--d) * 110ms); }
  .cta { text-align: right; animation: fade-up var(--dur-slow) var(--ease-out) 500ms both; }
  .cta p { margin: 0 0 16px; color: var(--w-60); font-size: 16px; line-height: 1.4; }
  .resume { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; }
  .dl { display: grid; width: 24px; height: 24px; transition: transform var(--dur) var(--ease-out); }
  .dl :global(svg) { width: 100%; height: 100%; }
  .resume:hover .dl { transform: translateY(3px); }

  /* Collage: three staggered columns, each tile cross-fades through its photos */
  .collage { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 56px; }
  .tile { position: relative; aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; background: var(--bw-15); }
  .t0 { margin-top: 48px; } .t2 { margin-top: -24px; }
  .t3 { margin-top: -36px; } .t5 { margin-top: -84px; }
  .tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.4s ease, scale 1.2s var(--ease-out); }
  .tile :global(img.on) { opacity: 1; }
  .tile:hover :global(img) { scale: 1.04; }
  .caption { grid-column: 3; margin: 4px 0 0; text-align: right; font-size: 12px; color: var(--w-50); }

  /* Philosophy and bio */
  .mission { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 96px; }
  .philosophy { margin: 0; font-size: 22px; line-height: 1.4; font-weight: 500; }
  .bio { margin: 0; font-size: 15px; line-height: 1.75; color: var(--w-80); }

  /* Skills */
  .skills { margin-top: 120px; }
  .skills h2 { text-align: center; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 900px; margin: 0 auto; }
  .skill { padding: 40px 32px 36px; border-radius: 20px; background: #161616; border: 1px solid rgba(255, 255, 255, 0.04); text-align: center; overflow: hidden; perspective: 800px; }
  .art { height: 220px; display: grid; place-items: center; margin-bottom: 28px; }
  .art :global(svg) { display: block; height: 220px; width: auto; max-width: 100%; overflow: visible; }
  .art :global(svg > *) { transform-box: fill-box; transform-origin: center; }
  h3 { margin: 0 0 12px; font-size: 20px; line-height: 1.3; }
  .skill p { margin: 0 auto; max-width: 300px; font-size: 14px; line-height: 1.5; color: var(--w-60); }

  /* Work */
  .work { margin-top: 120px; max-width: 900px; }
  .work ul { list-style: none; margin: 0; padding: 0; }
  .work li { display: grid; grid-template-columns: 32px 1.1fr 1.4fr auto; align-items: center; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); font-size: 15px; transition: background var(--dur) var(--ease-out), padding var(--dur) var(--ease-out); }
  .work li:hover { background: rgba(255, 255, 255, 0.03); padding-left: 8px; padding-right: 8px; }
  .ico { display: grid; width: 28px; height: 28px; }
  .ico :global(svg) { width: 100%; height: 100%; }
  .co { font-weight: 500; }
  .role { color: var(--w-60); }
  .yr { color: var(--w-50); font-variant-numeric: tabular-nums; }

  /* Clients */
  .clients { margin-top: 120px; max-width: 900px; }
  .clients ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px 16px; align-items: center; justify-items: center; }
  .clients li { height: 40px; display: grid; place-items: center; }
  .clients li :global(svg) { max-height: 40px; max-width: 100%; width: auto; height: auto; }
  .clients li :global(svg *) { transition: fill-opacity var(--dur) var(--ease-out); }
  .clients li:hover :global(svg *) { fill-opacity: 1; }

  /* ---------- Skill illustration variants ---------- */

  /* 1. Assemble: shapes fly in from around the card and click together */
  [data-fx='assemble'] .art :global(svg > *) {
    opacity: 0;
    translate: calc((mod(var(--i), 3) - 1) * 70px) calc((mod(var(--i), 2) * 2 - 1) * 50px);
    rotate: calc((mod(var(--i), 5) - 2) * 25deg);
    scale: 0.4;
    transition: opacity 0.6s var(--ease-out), translate 0.9s var(--ease-out), rotate 0.9s var(--ease-out), scale 0.9s var(--ease-out);
    transition-delay: calc(min(var(--i), 14) * 35ms);
  }
  [data-fx='assemble'] .skill:global(.is-visible) .art :global(svg > *) { opacity: 1; translate: 0 0; rotate: 0deg; scale: 1; }
  [data-fx='assemble'] .skill:global(.is-visible):hover .art :global(svg > *) {
    translate: calc((mod(var(--i), 3) - 1) * 6px) calc((mod(var(--i), 2) * 2 - 1) * 6px);
    transition-delay: 0s;
    transition-duration: 0.4s;
  }

  /* 2. Float: every shape breathes on its own rhythm; stronger on hover */
  [data-fx='float'] .skill { --amp: 4px; }
  [data-fx='float'] .skill:hover { --amp: 10px; }
  [data-fx='float'] .art :global(svg > *) {
    animation: bob calc(3s + mod(var(--i), 4) * 0.6s) ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.37s);
  }

  /* 3. Cursor: shapes sit at different depths and follow the cursor */
  [data-fx='cursor'] .art { transform: rotateX(calc(var(--py, 0) * -6deg)) rotateY(calc(var(--px, 0) * 6deg)); transition: transform 0.4s var(--ease-out); }
  [data-fx='cursor'] .art :global(svg > *) {
    --depth: calc(0.3 + mod(var(--i), 4) * 0.35);
    translate: calc(var(--px, 0) * var(--depth) * 16px) calc(var(--py, 0) * var(--depth) * 16px);
    transition: translate 0.35s var(--ease-out);
  }

  /* 4. Pop: shapes pop in one by one with a bounce; hover sends a wave through them */
  [data-fx='pop'] .art :global(svg > *) {
    scale: 0;
    transition: scale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(min(var(--i), 20) * 45ms + 150ms);
  }
  [data-fx='pop'] .skill:global(.is-visible) .art :global(svg > *) { scale: 1; }
  [data-fx='pop'] .skill:hover .art :global(svg > *) {
    animation: wave 0.7s ease-in-out;
    animation-delay: calc(min(var(--i), 20) * 35ms);
  }

  /* 5. Live: each illustration acts out its skill while the card is hovered */
  [data-fx='live'] .art :global(svg > *) { animation-duration: 2.4s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  /* Design system: swatches pulse in a diagonal wave */
  [data-fx='live'] [data-skill='ds']:hover .art :global(svg > *) { animation-name: swatch; animation-delay: calc(var(--i) * 70ms); }
  /* UI: list rows slide in again and again */
  [data-fx='live'] [data-skill='ui']:hover .art :global(svg > *) { animation-name: row; animation-delay: calc(var(--i) * 60ms); }
  /* UX: the flow lights up step by step */
  [data-fx='live'] [data-skill='ux']:hover .art :global(svg > *) { animation-name: step; animation-duration: 3.2s; animation-delay: calc(var(--i) * 100ms); }
  /* Branding: shapes turn and swap weight */
  [data-fx='live'] [data-skill='brand']:hover .art :global(svg > *) { animation-name: brand; animation-duration: 3s; animation-delay: calc(var(--i) * -1s); }
  /* Video: shapes bounce like an equalizer */
  [data-fx='live'] [data-skill='video']:hover .art :global(svg > *) { animation-name: beat; animation-duration: 0.9s; animation-delay: calc(var(--i) * 0.18s); }
  /* Marketing: everything bursts out of the megaphone */
  [data-fx='live'] [data-skill='marketing']:hover .art :global(svg > *) { animation-name: burst; animation-duration: 1.8s; animation-delay: calc(var(--i) * 0.12s); }

  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes bob { from { translate: 0 calc(var(--amp) * -1); } to { translate: 0 var(--amp); } }
  @keyframes wave { 40% { scale: 1.15; } 100% { scale: 1; } }
  @keyframes swatch { 0%, 100% { scale: 1; } 20% { scale: 1.18; } 40% { scale: 1; } }
  @keyframes row { 0% { translate: 0 0; opacity: 1; } 15% { translate: 24px 0; opacity: 0; } 30% { translate: -12px 0; opacity: 0; } 45%, 100% { translate: 0 0; opacity: 1; } }
  @keyframes step { 0%, 100% { opacity: 0.35; } 15%, 30% { opacity: 1; scale: 1.08; } 45% { opacity: 0.35; scale: 1; } }
  @keyframes brand { 0%, 100% { rotate: 0deg; scale: 1; } 33% { rotate: 20deg; scale: 1.08; } 66% { rotate: -14deg; scale: 0.94; } }
  @keyframes beat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -14px; } }
  @keyframes burst { 0% { scale: 1; } 25% { scale: 1.15; translate: 0 -6px; } 50% { scale: 1; translate: 0 0; } 100% { scale: 1; } }

  @media (max-width: 800px) {
    .hero { flex-direction: column; }
    .cta { text-align: left; }
    .collage { grid-template-columns: 1fr 1fr; }
    .tile { margin-top: 0 !important; }
    .caption { grid-column: 1 / -1; }
    .mission, .grid { grid-template-columns: 1fr; }
    .work li { grid-template-columns: 28px 1fr auto; }
    .role { display: none; }
    .clients ul { grid-template-columns: repeat(3, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .line > span, .cta { animation: none; }
    .art :global(svg > *) { animation: none !important; transition: none !important; opacity: 1 !important; scale: 1 !important; translate: 0 0 !important; rotate: 0deg !important; }
  }
</style>

<script>
  // Collage: each tile cross-fades to its next photo every few seconds, tiles out of step.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.collage .tile').forEach((tile) => {
      const imgs = [...tile.querySelectorAll('img')];
      if (imgs.length < 2) return;
      let i = 0;
      const t = Number(tile.dataset.tile);
      setTimeout(() => {
        setInterval(() => {
          imgs[i].classList.remove('on');
          i = (i + 1) % imgs.length;
          imgs[i].classList.add('on');
        }, 6000);
      }, t * 900);
    });
  }

  // Cursor variant: tell each card where the cursor is, from -1 to 1.
  const section = document.querySelector<HTMLElement>('.skills[data-fx="cursor"]');
  if (section && matchMedia('(hover: hover)').matches) {
    section.querySelectorAll<HTMLElement>('.skill').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--px', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        card.style.setProperty('--py', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--px', '0');
        card.style.setProperty('--py', '0');
      });
    });
  }
</script>
