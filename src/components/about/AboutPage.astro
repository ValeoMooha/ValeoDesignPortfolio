---
// Wraps an About variant with the page shell and the variant switcher.
import PageLayout from '../../layouts/PageLayout.astro';
import VariantNav from '../VariantNav.astro';

interface Props { variant: number; set?: 'classic' | 'concepts' }
const { variant, set = 'concepts' } = Astro.props;
// Current round: the live site's structure with five ways to animate the skill art.
const classic = [
  { label: 'Сборка', href: '/about/' },
  { label: 'Дыхание', href: '/about/c2/' },
  { label: 'Глубина', href: '/about/c3/' },
  { label: 'Волна', href: '/about/c4/' },
  { label: 'Живые', href: '/about/c5/' },
];
// Earlier concept round, kept for reference.
const concepts = [
  { label: 'Кино', href: '/about/v1/' },
  { label: 'Бенто', href: '/about/v2/' },
  { label: 'Журнал', href: '/about/v3/' },
  { label: 'Созвездие', href: '/about/v4/' },
  { label: 'Плёнка', href: '/about/v5/' },
  { label: 'Рабочий стол', href: '/about/v6/' },
  { label: 'Тоннель', href: '/about/v7/' },
  { label: 'Чат', href: '/about/v8/' },
  { label: 'Горизонт', href: '/about/v9/' },
  { label: 'Карточка', href: '/about/v10/' },
];
---

<PageLayout title="About — Valeo" description="Valeo is a multidisciplinary product designer living in Spain." current="about">
  <slot />
  <VariantNav slot="after" title="About" current={variant} variants={set === 'classic' ? classic : concepts} />
</PageLayout>
