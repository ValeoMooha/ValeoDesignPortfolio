---
// Variant 4 — Constellation: the portrait sits in the middle of an orbit of
// skills, the career is drawn as a constellation across the sky and the
// photos float like scattered snapshots.
import { Image } from 'astro:assets';
import { bio, experience, intro, philosophy, photos, portraits, skills } from '../../data/about';

// Career stars: newest on the right, alternating heights like a real constellation.
const career = [...experience].reverse();
const W = 1100;
const H = 300;
const points = career.map((j, i) => ({
  ...j,
  x: 40 + (i / (career.length - 1)) * (W - 80),
  y: 70 + ((i * 97) % 5) * 40,
  r: i === career.length - 1 ? 7 : i >= career.length - 4 ? 5 : 3.5,
}));
const path = points.map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`).join(' ');
const snaps = photos.filter((p) => p !== portraits.outdoor).slice(0, 12);
---

<section class="orbit-hero">
  <div class="orbit" aria-hidden="true">
    <span class="ring r1"></span>
    <span class="ring r2"></span>
    <span class="ring r3"></span>
    <div class="spin">
      {skills.map((s, i) => (
        <span class="planet" style={`--a: ${(i / skills.length) * 360}deg`}>
          <span class="planet-label">{s.icon} {s.short}</span>
        </span>
      ))}
    </div>
    <div class="core">
      <Image src={portraits.outdoor} alt="" width={360} height={360} loading="eager" />
    </div>
  </div>
  <div class="hero-text">
    <h1>{intro.greeting}<br /><span>{intro.role}, {intro.location}</span></h1>
    <p>{intro.status}</p>
    <a class="resume" href={intro.resume.href}>{intro.resume.label} ↓</a>
  </div>
</section>

<section class="mission">
  <p class="quote" data-reveal>{philosophy}</p>
  <p class="bio" data-reveal>{bio}</p>
</section>

<section class="skills">
  <h2 data-reveal>Skills and expertise</h2>
  <div class="grid">
    {skills.map((s, i) => (
      <article data-reveal style={`--reveal-i: ${i % 3}`}>
        <span class="glyph">{s.icon}</span>
        <h3>{s.title}</h3>
        <p>{s.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="sky">
  <h2 data-reveal>Work experience</h2>
  <svg class="map" viewBox={`0 0 ${W} ${H + 60}`} role="img" aria-label="Career constellation">
    <path class="link" d={path} pathLength="1" />
    {points.map((p, i) => (
      <g class="star" style={`--i: ${i}`}>
        <circle cx={p.x} cy={p.y} r={p.r * 3} class="halo" />
        <circle cx={p.x} cy={p.y} r={p.r} />
        <text x={p.x} y={p.y + (p.y > 150 ? -22 : 30)} text-anchor="middle" class="yr">{p.period.split(' ')[0]}</text>
        <text x={p.x} y={p.y + (p.y > 150 ? -40 : 48)} text-anchor="middle" class="co">{p.company}</text>
      </g>
    ))}
  </svg>
  <ul class="list">
    {experience.map((j) => (
      <li data-reveal><b>{j.company}</b><span>{j.role}</span><time>{j.period}</time></li>
    ))}
  </ul>
</section>

<section class="snaps">
  <h2 data-reveal>{intro.photosCaption}</h2>
  <div class="scatter">
    {snaps.map((p, i) => (
      <figure style={`--r: ${((i * 37) % 13) - 6}deg; --y: ${((i * 53) % 7) * 6}px`} data-reveal>
        <Image src={p} alt="" width={320} />
      </figure>
    ))}
  </div>
</section>

<style>
  section { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  h2 { font-size: clamp(26px, 3vw, 40px); margin: 0 0 32px; letter-spacing: -0.01em; }

  /* Orbit hero */
  .orbit-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; min-height: calc(100vh - 64px); }
  .orbit { position: relative; aspect-ratio: 1; max-width: 560px; width: 100%; justify-self: center; container-type: inline-size; }
  .ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.08); }
  .r1 { inset: 18%; }
  .r2 { inset: 4%; border-style: dashed; border-color: rgba(185, 166, 255, 0.25); }
  .r3 { inset: -8%; border-color: rgba(255, 255, 255, 0.04); }
  .spin { position: absolute; inset: 4%; animation: spin 60s linear infinite; }
  .planet { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform: rotate(var(--a)) translateY(-46cqw); }
  .planet-label {
    position: absolute; translate: -50% -50%;
    white-space: nowrap; padding: 6px 12px; border-radius: 100px;
    background: rgba(20, 20, 26, 0.8); border: 1px solid rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font-size: 13px;
    /* Counter-rotate so labels stay upright while the orbit turns */
    transform: rotate(calc(-1 * var(--a)));
    animation: counter 60s linear infinite;
  }
  .core { position: absolute; inset: 27%; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.04), 0 0 80px rgba(109, 91, 255, 0.45); animation: pop 1.2s var(--ease-out) both; }
  .core :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .hero-text h1 { margin: 0; font-size: clamp(40px, 5vw, 72px); line-height: 1.02; letter-spacing: -0.02em; animation: fade-up 1s var(--ease-out) 200ms both; }
  .hero-text h1 span { color: var(--w-50); }
  .hero-text p { margin: 24px 0 0; font-size: 20px; color: var(--w-80); animation: fade-up 1s var(--ease-out) 350ms both; }
  .resume { display: inline-block; margin-top: 24px; padding: 10px 20px; border-radius: 100px; background: var(--bw-100); color: #000; font-weight: 500; animation: fade-up 1s var(--ease-out) 500ms both; transition: scale var(--dur) var(--ease-out); }
  .resume:hover { scale: 1.05; }

  .mission { margin-top: 80px; }
  .quote { margin: 0; font-size: clamp(28px, 3.6vw, 52px); font-weight: 700; line-height: 1.15; background: linear-gradient(120deg, #fff 30%, #b9a6ff 60%, #ff8fb1); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .bio { margin: 32px 0 0; max-width: 760px; font-size: 20px; line-height: 1.6; color: var(--w-80); }

  .skills { margin-top: 140px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid article { padding: 28px; border-radius: 24px; background: radial-gradient(120% 100% at 0% 0%, rgba(109, 91, 255, 0.14), transparent 60%), rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07); }
  .glyph { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(185, 166, 255, 0.5); box-shadow: 0 0 20px rgba(185, 166, 255, 0.35); }
  .grid h3 { margin: 18px 0 8px; font-size: 19px; }
  .grid p { margin: 0; color: var(--w-60); line-height: 1.5; }

  /* Career constellation draws itself when it scrolls in */
  .sky { margin-top: 140px; }
  .map { width: 100%; height: auto; overflow: visible; }
  .link { fill: none; stroke: rgba(185, 166, 255, 0.45); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .star circle { fill: #fff; }
  .star .halo { fill: rgba(185, 166, 255, 0.18); }
  .yr { fill: rgba(255, 255, 255, 0.5); font-size: 13px; }
  .co { fill: #fff; font-size: 14px; font-weight: 500; }
  .star { opacity: 0; transition: opacity 0.6s var(--ease-out); transition-delay: calc(400ms + var(--i) * 120ms); }
  .sky.drawn .link { stroke-dashoffset: 0; transition: stroke-dashoffset 2.4s var(--ease-out) 200ms; }
  .sky.drawn .star { opacity: 1; }
  .list { display: none; list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; gap: 2px; padding: 14px 0; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .list span { color: var(--w-60); }
  .list time { color: var(--w-50); font-size: 14px; }

  /* Scattered snapshots straighten up on hover */
  .snaps { margin-top: 140px; }
  .snaps h2 { font-size: 20px; color: var(--w-60); font-weight: 500; }
  .scatter { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 24px; }
  .scatter figure { margin: 0; padding: 8px 8px 28px; background: #f4f1ea; border-radius: 4px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); rotate: var(--r); translate: 0 var(--y); transition: rotate var(--dur) var(--ease-out), scale var(--dur) var(--ease-out), translate var(--dur) var(--ease-out); }
  .scatter figure:hover { rotate: 0deg; scale: 1.08; translate: 0 calc(var(--y) - 8px); z-index: 2; position: relative; }
  .scatter :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes counter { from { transform: rotate(calc(-1 * var(--a))); } to { transform: rotate(calc(-1 * var(--a) - 360deg)); } }
  @keyframes pop { from { scale: 0.6; opacity: 0; } to { scale: 1; opacity: 1; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 900px) {
    .orbit-hero { grid-template-columns: 1fr; min-height: 0; padding-top: 32px; }
    .grid { grid-template-columns: 1fr; }
    .map { display: none; }
    .list { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .spin, .planet-label, .core, .hero-text h1, .hero-text p, .resume { animation: none; }
    .link { stroke-dashoffset: 0; }
    .star { opacity: 1; transition: none; }
  }
</style>

<script>
  const sky = document.querySelector('.sky');
  if (sky) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { sky.classList.add('drawn'); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(sky);
  }
</script>
