---
import ProjectCard from './ProjectCard.astro';
import { bigProjects } from '../data/projects';
---

<section class="big" aria-label="Featured projects">
  {bigProjects.map((p) => <ProjectCard project={p} aspect="680 / 560" eager />)}
</section>

<style>
  .big {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    max-width: var(--content-width);
    margin: clamp(32px, 4vw, 96px) auto 0;
    padding: 0 24px;
  }
  @media (max-width: 600px) { .big { grid-template-columns: 1fr; } }
</style>
