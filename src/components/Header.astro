---
import ContactButton from './ContactButton.astro';
import avatar from '../assets/AvatarValeoGIF.gif';
import { socials } from '../data/socials';

interface Props {
  current?: 'work' | 'tools' | 'about' | 'contact';
}
const { current = 'work' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { id: 'work', label: 'Work', href: base + '/' },
  { id: 'tools', label: 'Tools', href: base + '/tools/' },
  { id: 'about', label: 'About', href: base + '/about/' },
];
---

<header class="header">
  <div class="inner">
    <a class="logo" href={base + '/'}>
      <img src={avatar.src} width="32" height="32" alt="" />
      <span>Valeo</span>
    </a>
    <nav class="menu" aria-label="Main">
      <span class="pill" aria-hidden="true"></span>
      {items.map((item) => (
        <a
          href={item.href}
          class:list={{ active: item.id === current }}
          aria-current={item.id === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <ContactButton />
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="drawer" id="mobile-menu" aria-hidden="true" inert>
  <nav class="drawer-nav" aria-label="Mobile">
    {[...items, { id: 'contact', label: 'Contact', href: base + '/contact/' }].map((item, i) => (
      <a href={item.href} aria-current={item.id === current ? 'page' : undefined} style={`--i: ${i}`}>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <nav class="drawer-social" aria-label="Social">
    {socials.map((l, i) => <a href={l.href} rel="noopener" target="_blank" style={`--i: ${i}`}>{l.label}</a>)}
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 16px 24px;
    height: 64px;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
  }
  /* Glass once the page scrolls under it */
  .header.scrolled {
    background-color: rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  .inner {
    --constellation-shift: -16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1144px;
    height: 32px;
  }
  .logo { display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 16px; line-height: 1.4; }
  .logo img { border-radius: 8px; display: block; }

  .menu {
    position: relative;
    display: flex;
    gap: 12px;
    font-weight: 500;
    font-size: 16px;
    line-height: 26px;
    color: rgba(255, 255, 255, 0.4);
  }
  .menu a {
    position: relative;
    z-index: 1;
    padding: 3px 12px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .menu a:hover, .menu .active { color: var(--bw-100); }
  /* Highlight that glides to the hovered item */
  .pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--pill-w, 0);
    transform: translateX(var(--pill-x, 0));
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    transition:
      transform var(--dur) var(--ease-out),
      width var(--dur) var(--ease-out);
  }


  /* Mobile menu: two-bar icon that opens a full-screen drawer */
  .burger {
    display: none;
    position: relative;
    width: 50px;
    height: 50px;
    margin-right: -14px; /* the bars, not the tap area, sit on the page gutter */
    padding: 0;
    border: 0;
    background: none;
    color: var(--bw-100);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .burger span {
    position: absolute;
    left: 14px;
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: all 0.2s cubic-bezier(0.1, 0.82, 0.76, 0.965);
  }
  .burger span:first-child { top: 19px; }
  .burger span:last-child { top: 29px; }
  .burger[aria-expanded='true'] span:first-child { top: 24px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { top: 24px; transform: rotate(-45deg); }

  /* The drawer blooms out of the icon as a growing circle; the links then
     slide up out of their own lines, one after another. */
  .drawer {
    --origin: calc(100% - 38px) 32px;
    position: fixed;
    inset: 0;
    z-index: 9; /* under the header, so the logo and the icon stay on top */
    display: none;
    flex-direction: column;
    justify-content: space-between;
    padding: 100px 24px 32px;
    background:
      radial-gradient(120% 60% at 100% 100%, rgba(228, 103, 228, 0.18), transparent 60%),
      radial-gradient(90% 50% at 0% 0%, rgba(90, 110, 255, 0.14), transparent 60%),
      var(--bw-0);
    overflow-y: auto;
    clip-path: circle(0px at var(--origin));
    visibility: hidden;
    transition:
      clip-path 0.6s cubic-bezier(0.77, 0, 0.175, 1),
      visibility 0s 0.6s;
  }
  .drawer.open {
    clip-path: circle(150vmax at var(--origin));
    visibility: visible;
    transition:
      clip-path 0.85s cubic-bezier(0.77, 0, 0.175, 1),
      visibility 0s;
  }
  .drawer-nav { display: flex; flex-direction: column; }
  .drawer-nav a {
    display: block;
    overflow: hidden;
    padding: 0 8px;
    font-weight: 700;
    font-size: 12vw;
    line-height: 15vw;
    color: var(--bw-100);
    transition: color var(--dur-fast);
  }
  .drawer-nav a span {
    display: block;
    transform: translateY(105%) rotate(7deg);
    transform-origin: 0 100%;
    transition: transform 0.35s cubic-bezier(0.5, 0, 0.75, 0);
  }
  .drawer.open .drawer-nav a span {
    transform: none;
    transition:
      transform 0.9s var(--ease-out) calc(0.28s + var(--i) * 80ms);
  }
  .drawer-social {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    margin-top: 48px;
  }
  .drawer-social a {
    padding: 4px 8px;
    font-weight: 600;
    font-size: 16px;
    line-height: 27px;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.25s,
      transform 0.25s,
      color var(--dur-fast);
  }
  .drawer.open .drawer-social a {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s calc(0.55s + var(--i) * 50ms),
      transform 0.7s var(--ease-out) calc(0.55s + var(--i) * 50ms),
      color var(--dur-fast);
  }
  @media (hover: hover) {
    .drawer-nav a:hover { color: #e467e4; }
    .drawer-social a:hover { color: #ff66ff; }
  }
  /* While the drawer is open the header is just a logo and the close icon */
  .header.menu-open {
    background-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  @media (max-width: 600px) {
    .menu, .inner :global(.contact) { display: none; }
    .burger { display: block; }
    .drawer { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer, .drawer.open, .burger span,
    .drawer-nav a span, .drawer.open .drawer-nav a span,
    .drawer-social a, .drawer.open .drawer-social a { transition: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill, .header { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header')!;
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const drawer = document.querySelector<HTMLElement>('.drawer')!;
  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.classList.toggle('open', open);
    drawer.toggleAttribute('inert', !open);
    drawer.setAttribute('aria-hidden', String(!open));
    header.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 601px)').addEventListener('change', (e) => e.matches && setOpen(false));
  // The page can come back from the bfcache with the drawer still open
  addEventListener('pageshow', () => setOpen(false));

  const menu = document.querySelector<HTMLElement>('.menu')!;
  // No menu item is active on the Contact page: the pill rests hidden
  const active = menu.querySelector<HTMLElement>('.active');
  const moveTo = (el: HTMLElement | null) => {
    menu.style.setProperty('--pill-x', `${el?.offsetLeft ?? 0}px`);
    menu.style.setProperty('--pill-w', `${el?.offsetWidth ?? 0}px`);
  };
  document.fonts.ready.then(() => moveTo(active));
  menu.querySelectorAll<HTMLElement>('a').forEach((a) => {
    a.addEventListener('pointerenter', () => moveTo(a));
    a.addEventListener('focus', () => moveTo(a));
  });
  menu.addEventListener('pointerleave', () => moveTo(active));
  addEventListener('resize', () => moveTo(active));
</script>
