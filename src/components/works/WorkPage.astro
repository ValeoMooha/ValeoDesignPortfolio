---
// Shell for a case study ported from mvaleo.com/works/<slug>. The markup is the
// original page and the styles are the original CSS scoped under .zc: shared
// rules in works-base.css, the page's own rules imported by the page file.
import PageLayout from '../../layouts/PageLayout.astro';
import '../../styles/works-base.css';

interface Props {
  title: string;
  description: string;
  raw: string;
  /** extra class on the .zc wrapper, e.g. "zc2" for an alternative version of a page */
  variant?: string;
}
const { title, description, raw, variant } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replaceAll('%BASE%', base);
---

<PageLayout title={title} description={description} current="work">
  <slot name="before" />
  <div class:list={['zc', variant]} set:html={html} />
</PageLayout>

<style is:global>
  .zc {
    color: var(--bw-100);
    font-family: var(--font);
    /* room under the last block so the pinned button never covers it */
    padding-bottom: 72px;
  }
  /* "Back to Portfolio": pinned to the bottom of the screen on every case page, as on
     the original site (the page's own rule only made it sticky inside its container). */
  .zc a.backtoportfolioblock.brxe-container {
    position: fixed;
    top: auto;
    right: auto;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    translate: -50% 0;
    z-index: 30;
    transition: background-color 0.25s, scale 0.25s;
  }
  .zc a.backtoportfolioblock.brxe-container:active { scale: 0.96; }
  @media (max-width: 767px) {
    .zc a.backtoportfolioblock.brxe-container { bottom: max(14px, env(safe-area-inset-bottom)); }
  }
</style>

<script>
  import Splide from '@splidejs/splide';

  // The original sliders (fade or slide, with dots) run on Splide with the
  // config stored in each element's data-x-slider attribute.
  document.querySelectorAll<HTMLElement>('.zc .x-slider').forEach((el) => {
    const slides = [...el.querySelectorAll<HTMLElement>('.splide__slide')];
    const ids = slides.map((s) => s.id);

    // Fade slides of different heights make the page jump on every change, so
    // all slides are given the height of the tallest one and centred in it.
    const equalize = () => {
      const real = slides.filter((s) => !s.classList.contains('splide__slide--clone'));
      real.forEach((s) => (s.style.minHeight = ''));
      const tallest = Math.max(0, ...real.map((s) => s.getBoundingClientRect().height));
      real.forEach((s) => {
        s.style.minHeight = `${tallest}px`;
        s.style.alignItems = 'center';
      });
    };

    try {
      const { rawConfig } = JSON.parse(el.dataset.xSlider ?? '{}');
      const config = { ...rawConfig };
      delete config.lazyLoad;
      delete config.preloadPages;
      if (config.interval) config.interval = Number(config.interval);
      const splide = new Splide(el, config);
      splide.on('mounted', () => {
        // Splide renames slides, which would detach the #id rules of the original CSS
        const renamed = new Map<string, string>();
        slides.forEach((s, i) => {
          if (!ids[i]) return;
          renamed.set(s.id, ids[i]);
          s.id = ids[i];
        });
        el.querySelectorAll('[aria-controls]').forEach((b) => {
          const id = renamed.get(b.getAttribute('aria-controls') ?? '');
          if (id) b.setAttribute('aria-controls', id);
        });
        equalize();
      });
      splide.mount();
      el.querySelectorAll('img').forEach((img) => img.addEventListener('load', equalize));
      let width = el.clientWidth;
      new ResizeObserver(() => {
        if (el.clientWidth === width) return;
        width = el.clientWidth;
        equalize();
      }).observe(el);
    } catch {
      /* a broken slider config just leaves the first slide showing */
    }
  });

  // Videos and the YouTube embed only load and play while they are near the screen.
  const lazy = document.querySelectorAll<HTMLVideoElement | HTMLIFrameElement>('.zc [data-src]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        if (target instanceof HTMLVideoElement) {
          if (isIntersecting) {
            if (!target.src) target.src = target.dataset.src!;
            target.muted = true;
            target.play().catch(() => {});
          } else target.pause();
        } else if (isIntersecting && !target.src) {
          target.src = (target as HTMLElement).dataset.src!;
        }
      }
    },
    { rootMargin: '400px 0px' },
  );
  lazy.forEach((el) => io.observe(el));
</script>
