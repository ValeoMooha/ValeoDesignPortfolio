---
// Prototype only: compare hover effects live. Remove once a variant is chosen.
const groups = [
  {
    key: 'contact',
    title: 'Contact',
    options: [
      { id: 'constellation', label: 'A Созвездие' },
      { id: 'orbit', label: 'B Орбита' },
      { id: 'glass', label: 'C Стекло' },
      { id: 'decode', label: 'D Расшифровка' },
    ],
  },
];
---

<div class="switcher" aria-label="Hover variants">
  {groups.map((g) => (
    <div class="group" data-group={g.key}>
      <span class="title">{g.title}</span>
      {g.options.map((o) => (
        <button type="button" data-value={o.id}>{o.label}</button>
      ))}
    </div>
  ))}
</div>

<style>
  .switcher {
    position: fixed;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    max-width: calc(100vw - 24px);
  }
  .group {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 100px;
    background: rgba(20, 20, 20, 0.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font);
    font-size: 13px;
  }
  .title { padding: 0 8px 0 10px; color: var(--w-50); }
  button {
    border: 0;
    padding: 6px 10px;
    border-radius: 100px;
    background: transparent;
    color: var(--w-60);
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s;
  }
  button:hover { color: var(--bw-100); }
  button[aria-pressed='true'] { background: rgba(255, 255, 255, 0.14); color: var(--bw-100); }
</style>

<script>
  const root = document.documentElement;
  const params = new URLSearchParams(location.search);

  document.querySelectorAll<HTMLElement>('.switcher .group').forEach((group) => {
    const key = group.dataset.group!;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    const set = (value: string) => {
      root.dataset[key] = value;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === value)));
      const url = new URL(location.href);
      url.searchParams.set(key, value);
      history.replaceState(null, '', url);
    };
    const initial = params.get(key);
    set(buttons.some((b) => b.dataset.value === initial) ? initial! : buttons[0].dataset.value!);
    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.value!)));
  });
</script>
